# Environment variables — NEVER commit real values
# Copy this to .env and fill in your secrets

# Google Cloud
GOOGLE_CLOUD_PROJECT=zombie-saas-coordinator
GOOGLE_CLOUD_REGION=asia-south1

# Firebase
FIREBASE_PROJECT_ID=zombie-saas-coordinator

# Gemini Models (via Vertex AI)
GEMINI_PRO_MODEL=gemini-2.0-pro
GEMINI_FLASH_MODEL=gemini-2.0-flash

# External API Keys (store in Secret Manager for production)
TRELLO_API_KEY=
TRELLO_API_TOKEN=
ASANA_ACCESS_TOKEN=
ZAPIER_CLIENT_ID=
ZAPIER_CLIENT_SECRET=
MAKE_API_TOKEN=

# Slack Integration
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Webhook Security
EXPENSE_WEBHOOK_SECRET=

# Cloud SQL
CLOUDSQL_CONNECTION_NAME=
CLOUDSQL_DB_NAME=zombie_saas
CLOUDSQL_DB_USER=
CLOUDSQL_DB_PASSWORD=
